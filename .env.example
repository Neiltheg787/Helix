# Helix environment reference. Copy to `.env.local` for local development.
# Missing optional services degrade visibly to local/demo mode; Helix must not fake cloud sync, AI, checkout, or AR handoff success.

# NEXT_PUBLIC_APP_URL
# Optional, public. Feature: Stripe return URLs, AR/share links. Format: absolute URL.
# Missing behavior: uses request origin or http://localhost:3000 where supported.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPENAI_API_KEY
# Optional, server-only. Feature: AI copilot, CAD/OpenSCAD generation, PCBFlow script generation, transcription, suggestions.
# Format: sk-... or project API key. Missing behavior: AI routes return structured "missing key" errors.
OPENAI_API_KEY=

# OPENAI_BEST_MODEL / OPENAI_CAD_MODEL / OPENAI_FIRMWARE_MODEL / OPENAI_TRANSCRIBE_MODEL / OPENAI_SUGGESTIONS_MODEL
# Optional, server-only. Feature: model selection. Format: OpenAI model id.
OPENAI_BEST_MODEL=o3
# OPENAI_CAD_MODEL=
OPENAI_FIRMWARE_MODEL=o3
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_SUGGESTIONS_MODEL=gpt-4o-mini

# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Optional, public. Feature: OAuth, workspace sync, teams, AR handoffs. Format: Supabase project URL and publishable/anon key.
# Missing behavior: local demo mode remains available unless NEXT_PUBLIC_REQUIRE_SUPABASE_AUTH=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy accepted alias: NEXT_PUBLIC_SUPABASE_ANON_KEY

# SUPABASE_SERVICE_ROLE_KEY
# Optional, server-only. Feature: server-side workspace/order persistence and large AR handoff storage. Format: Supabase service_role key.
# Missing behavior: protected persistence APIs return setup errors; local demo storage continues.
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_REQUIRE_SUPABASE_AUTH
# Optional, public. Feature: require real Supabase OAuth instead of deliberate demo mode. Format: true/false.
# Missing behavior: false; Helix signs into local demo mode.
NEXT_PUBLIC_REQUIRE_SUPABASE_AUTH=false

# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
# Optional, server-only. Feature: manufacturing checkout and webhook verification. Format: sk_test_... or sk_live_..., whsec_...
# Missing behavior: quote is shown; checkout buttons explain Stripe is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# FAB_* quote tuning
# Optional, server-only. Feature: server-priced fabrication quotes. Format: integer cents.
FAB_PCB_CENTS_PER_CM2=14
FAB_PCB_MIN_CENTS=2200
FAB_PCB_MAX_CENTS=250000
FAB_CAD_CENTS_PER_DM3=1400
FAB_CAD_MIN_CENTS=900
FAB_CAD_MAX_CENTS=80000
FAB_PLATFORM_FEE_CENTS=500

# CIRCUITRON_MCP_URL / MCP_URL / CIRCUITRON_BIN / CIRCUITRON_TIMEOUT_MS / CIRCUITRON_KICAD_IMAGE
# Optional, server-only. Feature: Circuitron/KiCad PCB generation. Format: URL, executable path, timeout ms, Docker image.
# Missing behavior: PCB generation reports the dependency issue and uses only supported local fallbacks.
CIRCUITRON_MCP_URL=http://localhost:8051
# MCP_URL=http://localhost:8051
# CIRCUITRON_BIN=
CIRCUITRON_TIMEOUT_MS=1800000
CIRCUITRON_KICAD_IMAGE=ghcr.io/shaurya-sethi/circuitron-kicad:latest
# Local demo only: CIRCUITRON_SKIP_MCP_CHECK=1

# HELIX_PCBFLOW_MODEL / HELIX_PCBFLOW_STAGE_PLAN_MODEL / HELIX_PCBFLOW_TIMEOUT_MS / HELIX_PYTHON
# Optional, server-only. Feature: PCBFlow Python pipeline. Format: model id, timeout ms, Python executable path.
# Missing behavior: defaults to .venv-pcbflow/bin/python3 when present, then python3.
HELIX_PCBFLOW_MODEL=gpt-4o-mini
HELIX_PCBFLOW_STAGE_PLAN_MODEL=gpt-4o-mini
HELIX_PCBFLOW_TIMEOUT_MS=120000
# HELIX_PYTHON=/path/to/python3
# Legacy aliases still accepted: NODE0_PCBFLOW_MODEL, NODE0_PCBFLOW_STAGE_PLAN_MODEL, NODE0_PCBFLOW_TIMEOUT_MS, NODE0_PYTHON

# EVERMIND_API_KEY / EVERMIND_USER_ID / EVERMIND_BASE_URL
# Optional, server-only. Feature: memory recall for the copilot. Format: provider API key, stable user id, URL.
# Missing behavior: memory recall/write is skipped.
EVERMIND_API_KEY=
EVERMIND_USER_ID=helix-demo
# EVERMIND_BASE_URL=https://api.evermind.ai

# BUTTERBASE_API_KEY / BUTTERBASE_APP_ID / BUTTERBASE_EVENTS_TABLE / BUTTERBASE_BASE_URL
# Optional, server-only. Feature: backend event logging. Format: provider key/id/table/URL.
# Missing behavior: event logging is skipped.
BUTTERBASE_API_KEY=
BUTTERBASE_APP_ID=
BUTTERBASE_EVENTS_TABLE=helix_events
# BUTTERBASE_BASE_URL=https://api.butterbase.dev

# LOGFIRE_*
# Optional, server-only. Feature: Circuitron child-process observability. Missing behavior: omitted.
# LOGFIRE_SEND_TO_LOGFIRE=
# LOGFIRE_BASE_URL=
# LOGFIRE_TOKEN=
# LOGFIRE_PROJECT_NAME=

# NEXT_TELEMETRY_DISABLED
# Optional, server/build. Feature: disables Next telemetry. Format: 1.
NEXT_TELEMETRY_DISABLED=1
