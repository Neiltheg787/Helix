# Helix native Jac environment

# Optional. Used by Jac byLLM when [byllm.model].default_model is an OpenAI model.
# byLLM is provided by the Jac 0.34.7 toolchain; do not add an incompatible
# PyPI byllm pin unless the Jac release notes require it.
OPENAI_API_KEY=

# Optional. Used by byLLM for Anthropic models if configured in jac.toml.
ANTHROPIC_API_KEY=

# Optional. Local deployment port for jac start.
PORT=8000

# Optional. Public origin allowed by an external reverse proxy when the
# JacHammer client and API are split across origins. Same-origin deployment
# through jac start is the default and does not need this variable.
HELIX_PUBLIC_ORIGIN=http://localhost:8000

# Optional. External workers used by Jac orchestration walkers.
HELIX_CAD_WORKER_URL=
HELIX_PCB_WORKER_URL=
HELIX_FIRMWARE_WORKER_URL=
HELIX_STRIPE_CHECKOUT_URL=
