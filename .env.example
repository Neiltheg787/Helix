# Helix native Jac environment

# Optional. Used by Jac byLLM when [byllm.model].default_model is an OpenAI model.
# byLLM is provided by the Jac 0.34.7 toolchain; do not add an incompatible
# PyPI byllm pin unless the Jac release notes require it.
OPENAI_API_KEY=

# Optional. Used by byLLM for Anthropic models if configured in jac.toml.
ANTHROPIC_API_KEY=

# Optional. Local deployment port for jac start.
PORT=8000

# Optional, server-side only. Next.js rewrite target for the JaC API service.
# Keep this private so browser requests remain same-origin. Use an HTTPS origin
# in production. Defaults to http://127.0.0.1:8000 when omitted.
HELIX_JAC_ORIGIN=http://127.0.0.1:8000

# Optional, public. Direct browser API origin used only when same-origin Next
# rewrites are unavailable. The JaC service must allow CORS and use HTTPS.
# Leave empty for the safer same-origin rewrite topology.
NEXT_PUBLIC_HELIX_API_URL=

# Optional. Public frontend origin allowed by an external reverse proxy.
HELIX_PUBLIC_ORIGIN=http://localhost:3000

# Optional. External workers used by Jac orchestration walkers.
HELIX_CAD_WORKER_URL=
HELIX_PCB_WORKER_URL=
HELIX_FIRMWARE_WORKER_URL=
HELIX_STRIPE_CHECKOUT_URL=
